# Modo padrão: tudo local com `npm run dev`.
VITE_API_BASE_URL=http://127.0.0.1:3100
VITE_TOTEM_ID=totem-tiete-01

# API Java/Spring Boot, quando iniciada separadamente em apps/api.
PORT=8080
API_BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=demo
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Alternativa: clientes locais conectados ao Appwrite Cloud.
# Comente VITE_API_BASE_URL antes de habilitar estas três variáveis.
# VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# VITE_APPWRITE_PROJECT_ID=6aa6f5a70039265e6516
# VITE_APPWRITE_FUNCTION_ID=embarque-api

# Integração futura do Spring; nunca exponha APPWRITE_API_KEY nos clientes.
# APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=6aa6f5a70039265e6516
# APPWRITE_DATABASE_ID=embarque
# APPWRITE_FUNCTION_ID=embarque-api
# APPWRITE_API_KEY=

# Android conectado ao Appwrite (nenhuma API key entra no APK).
# ANDROID_API_URL=https://fra.cloud.appwrite.io/v1
# ANDROID_DEMO_MODE_DEFAULT=false
