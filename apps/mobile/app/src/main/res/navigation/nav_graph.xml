<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/loginFragment" android:name="br.com.fiap.embarquefacil.ui.login.LoginFragment" android:label="Entrar">
        <action android:id="@+id/action_login_to_home" app:destination="@id/homeFragment" app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/homeFragment" android:name="br.com.fiap.embarquefacil.ui.home.HomeFragment" android:label="Início">
        <action android:id="@+id/action_home_to_journey" app:destination="@id/journeyFragment" />
    </fragment>
    <fragment android:id="@+id/journeyFragment" android:name="br.com.fiap.embarquefacil.ui.journey.JourneyFragment" android:label="Minha jornada">
        <action android:id="@+id/action_journey_to_scanner" app:destination="@id/scannerFragment" />
        <action android:id="@+id/action_journey_to_direction" app:destination="@id/directionFragment" />
        <action android:id="@+id/action_journey_to_handoff" app:destination="@id/handoffFragment" />
        <action android:id="@+id/action_journey_to_feedback" app:destination="@id/feedbackFragment" />
    </fragment>
    <fragment android:id="@+id/scannerFragment" android:name="br.com.fiap.embarquefacil.ui.scanner.ScannerFragment" android:label="Confirmar localização" />
    <fragment android:id="@+id/directionFragment" android:name="br.com.fiap.embarquefacil.ui.direction.DirectionFragment" android:label="Direção" />
    <fragment android:id="@+id/handoffFragment" android:name="br.com.fiap.embarquefacil.ui.handoff.HandoffFragment" android:label="Continuar no totem" />
    <fragment android:id="@+id/feedbackFragment" android:name="br.com.fiap.embarquefacil.ui.feedback.FeedbackFragment" android:label="Avaliação">
        <action android:id="@+id/action_feedback_to_home" app:destination="@id/homeFragment" app:popUpTo="@id/homeFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/profileFragment" android:name="br.com.fiap.embarquefacil.ui.profile.ProfileFragment" android:label="Perfil">
        <action android:id="@+id/action_profile_to_login" app:destination="@id/loginFragment" app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    </fragment>
</navigation>
