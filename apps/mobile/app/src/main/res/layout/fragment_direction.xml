<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siga até o próximo marco"
            android:textAppearance="@style/TextAppearance.EmbarqueFacil.Title" />
        <TextView
            android:id="@+id/destination_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/ef_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/arrow_image"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/content_arrow"
            android:src="@drawable/ic_arrow" />

        <TextView
            android:id="@+id/confidence_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/ef_warning_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Confiança do sensor: calculando…"
            android:textColor="@color/ef_warning"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ef_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/distance_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/ef_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/fallback_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/ef_warning_bg"
            android:padding="14dp"
            android:text="Use as instruções por etapas e confirme sua posição no próximo QR ou totem."
            android:textColor="@color/ef_warning"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speak_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ouvir instrução" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/recalibrate_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Como recalibrar" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/previous_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Etapa anterior" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/next_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Próxima etapa" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
