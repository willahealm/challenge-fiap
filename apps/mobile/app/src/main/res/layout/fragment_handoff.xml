<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continuar em um totem"
            android:textAppearance="@style/TextAppearance.EmbarqueFacil.Title" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Mostre este QR ao leitor do totem. Ele é temporário e só pode ser usado uma vez."
            android:textColor="@color/ef_muted" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp" />

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="20dp"
            android:contentDescription="QR temporário para transferir a jornada ao totem"
            android:visibility="gone" />
        <TextView
            android:id="@+id/code_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:textColor="@color/ef_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/countdown_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/ef_warning"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/ef_error"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/regenerate_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Gerar novo código"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/ef_warning_bg"
            android:padding="14dp"
            android:text="No totem aparecerão somente rota, horário e plataforma. A sessão visível será apagada ao encerrar ou ficar inativa."
            android:textColor="@color/ef_warning" />
    </LinearLayout>
</ScrollView>
